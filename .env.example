# Add a Portkey key to enable the PydanticAI model through Portkey.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-4o-mini-2024-07-18

# Optional direct OpenAI setup. Portkey is used when both providers are configured.
USE_REMOTE_MODEL=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
APP_SECRET=replace-with-a-long-random-string
# Optional absolute paths if you keep the course data pack elsewhere.
# DATABASE_PATH=/absolute/path/to/data/campus_customs.db
# PRODUCTS_DIR=/absolute/path/to/data/products
